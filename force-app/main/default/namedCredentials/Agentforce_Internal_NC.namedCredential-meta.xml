<?xml version="1.0" encoding="UTF-8"?>
<!--
  Named Credential: Agentforce Internal
  ======================================
  Base URL: https://YOUR_ORG.my.salesforce.com
  Used by:  AgentChatController (callout:Agentforce_Internal_NC/services/data/...)
  Auth:     OAuth 2.0 Client Credentials via Agentforce_Internal_EC
            → automatically injects Authorization: Bearer <token>
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Agentforce Internal</label>
    <type>SecuredEndpoint</type>
    <calloutStatus>Enabled</calloutStatus>
    <url>https://YOUR_ORG.my.salesforce.com</url>
    <externalCredential>Agentforce_Internal_EC</externalCredential>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
</NamedCredential>
