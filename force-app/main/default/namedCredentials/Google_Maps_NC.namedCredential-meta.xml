<?xml version="1.0" encoding="UTF-8"?>
<!-- Named Credential: Google Maps API (Distance Matrix)
     =====================================================
     Used by: Api_GoogleMapsService (getDrivingDistanceKm)
     Base URL: https://maps.googleapis.com

     After migration (Phase 5), replace the hardcoded endpoint in Api_GoogleMapsService
     for Distance Matrix calls with:
         req.setEndpoint('callout:Google_Maps_NC/maps/api/distancematrix/json?...');
     Remove the &key= query param — injected automatically by Google_Maps_EC.
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Google Maps API</label>
    <type>SecuredEndpoint</type>
    <calloutStatus>Enabled</calloutStatus>
    <url>https://maps.googleapis.com</url>
    <externalCredential>Google_Maps_EC</externalCredential>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
</NamedCredential>
