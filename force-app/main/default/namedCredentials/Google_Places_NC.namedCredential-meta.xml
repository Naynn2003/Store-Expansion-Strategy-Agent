<?xml version="1.0" encoding="UTF-8"?>
<!-- Named Credential: Google Places API
     =====================================
     Used by: Api_GoogleMapsService (computeInsights, searchText, Place Details)
     Base URL: https://places.googleapis.com

     After migration (Phase 5), replace the hardcoded endpoint in Api_GoogleMapsService
     for Places calls with:
         req.setEndpoint('callout:Google_Places_NC/v1/places:computeInsights');
     The External Credential (Google_Maps_EC) injects X-Goog-Api-Key header automatically.
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Google Places API</label>
    <type>SecuredEndpoint</type>
    <calloutStatus>Enabled</calloutStatus>
    <url>https://places.googleapis.com</url>
    <externalCredential>Google_Maps_EC</externalCredential>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
</NamedCredential>
