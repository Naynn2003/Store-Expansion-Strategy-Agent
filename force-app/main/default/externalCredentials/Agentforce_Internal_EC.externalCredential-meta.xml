<?xml version="1.0" encoding="UTF-8"?>
<!--
  External Credential: Agentforce Internal Auth
  =============================================
  Used by: Named Credential "Agentforce_Internal_NC"
  Purpose: OAuth 2.0 Client Credentials flow to call the Agentforce Agent REST API
           from within the same org (avoids INVALID_SESSION_ID rejection of UI tokens).

  AFTER DEPLOYING — 2 Setup steps required:
  1. Setup → Apps → App Manager → "Agentforce Self Caller" → ▼ → View
     → "Manage Consumer Details" → copy Consumer Key + Consumer Secret

  2. Setup → Security → Named Credentials → "External Credentials" tab
     → "Agentforce Internal Auth" → Edit
     → paste Consumer Key + Consumer Secret → Save

  That's it — no "Authenticate" button needed. Client Credentials flow
  automatically exchanges key/secret for an access token on every callout.
-->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>OAuth</authenticationProtocol>
    <label>Agentforce Internal Auth</label>
    <oauthSettings>
        <calloutClientId>REPLACE_WITH_CONSUMER_KEY_FROM_SETUP</calloutClientId>
        <oAuthFlowType>ClientCredentialFlow</oAuthFlowType>
        <oAuthTokenEndpointUrl>https://YOUR_ORG.my.salesforce.com/services/oauth2/token</oAuthTokenEndpointUrl>
        <scopes>api</scopes>
    </oauthSettings>
    <principalType>NamedPrincipal</principalType>
    <principals>
        <principalName>DefaultPrincipal</principalName>
        <sequenceNumber>1</sequenceNumber>
    </principals>
</ExternalCredential>
